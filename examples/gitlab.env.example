# Local development env for scripts/run-backend.ps1 and scripts/run-frontend.ps1.
# Keep the variable names aligned with deploy/.env.example where possible.

# Public access. Used by DingTalk detail links generated by the backend.
PLATFORM_BASE_URL=http://localhost:5173

# Local backend database credentials. If your local DB host/name differ, prefer DATABASE_URL.
# DATABASE_URL=mysql+pymysql://root:root@localhost:3306/ai_code_review?charset=utf8mb4
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# GitLab API is optional for webhook payloads that already include changed files.
# Enable it when MR payloads do not include diffs, Push compare fallback is needed, or rerun should refetch GitLab diffs.
GITLAB_API_ENABLED=true
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=your_gitlab_access_token
GITLAB_DIFF_PER_PAGE=100

# Optional local helper values used by some manual verification commands.
GITLAB_PROJECT_ID=12345
GITLAB_MR_IID=21

# Optional. Defaults to http://localhost:8090.
BACKEND_BASE_URL=http://localhost:8090
