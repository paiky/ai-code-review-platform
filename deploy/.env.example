# Public access. PUBLIC_HTTP_PORT is the host port exposed by the frontend container.
# PLATFORM_BASE_URL is used by backend-generated external links, such as DingTalk detail links.
APP_VERSION=local
PUBLIC_HTTP_PORT=8080
PLATFORM_BASE_URL=http://your-server-domain-or-ip:8080
BACKEND_PORT=8080

# External MySQL used by the Python backend
DATABASE_URL=mysql+pymysql://ai_review:change-password@192.168.100.88:3306/ai_code_review?charset=utf8mb4

# GitLab API is optional for webhook payloads that already include changed files.
# Enable it when MR payloads do not include diffs, Push compare fallback is needed, or rerun should refetch GitLab diffs.
GITLAB_API_ENABLED=false
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=your_gitlab_access_token
GITLAB_DIFF_PER_PAGE=100

# Code quality AI Review initial defaults. Existing database settings edited in the UI take precedence after first startup.
CODE_QUALITY_REVIEW_ENABLED=false
CODE_QUALITY_REVIEW_PROVIDER=DEEPSEEK
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CODE_REVIEW_MODEL=deepseek-v4-pro
OPENAI_API_KEY=
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
OPENAI_CODE_REVIEW_MODEL=gpt-5.4
ANTHROPIC_API_KEY=
ANTHROPIC_MESSAGES_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_CODE_REVIEW_MODEL=claude-sonnet-4-5

# Optional: only needed when enabling the bundled MySQL container with COMPOSE_PROFILES=local-mysql
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_DATABASE=ai_code_review
MYSQL_USERNAME=ai_review
MYSQL_PASSWORD=change-app-password
