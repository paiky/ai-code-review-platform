# Public access
APP_VERSION=local
PUBLIC_HTTP_PORT=8080
PLATFORM_BASE_URL=http://your-server-domain-or-ip:8080

# Backend container port. It is only used inside the Docker network by default.
BACKEND_PORT=8080

# MySQL container
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_DATABASE=ai_code_review

# Spring datasource used by backend container
MYSQL_URL=jdbc:mysql://mysql:3306/ai_code_review?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
MYSQL_USERNAME=ai_review
MYSQL_PASSWORD=change-app-password

# DingTalk notification
DINGTALK_ENABLED=true
DINGTALK_WEBHOOK_URL=

# GitLab diff fetching
GITLAB_API_ENABLED=false
GITLAB_BASE_URL=
GITLAB_TOKEN=
GITLAB_DIFF_PER_PAGE=100

# Code quality review
CODE_QUALITY_REVIEW_ENABLED=false
CODE_QUALITY_REVIEW_PROVIDER=OPENAI_API
CODEX_CLI_COMMAND=
CODEX_CLI_MODEL=
CODEX_CLI_TIMEOUT_SECONDS=600
OPENAI_API_KEY=
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
OPENAI_CODE_REVIEW_MODEL=gpt-5.5
OPENAI_CODE_REVIEW_TIMEOUT_SECONDS=120
ANTHROPIC_API_KEY=
ANTHROPIC_MESSAGES_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_CODE_REVIEW_MODEL=claude-sonnet-4-5
ANTHROPIC_CODE_REVIEW_TIMEOUT_SECONDS=120
